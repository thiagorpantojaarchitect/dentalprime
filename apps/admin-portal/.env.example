# Exemplo de variaveis de ambiente do admin-portal (frontend Vite).
# Copie para .env.local (ignorado pelo git). Variaveis expostas ao browser
# usam o prefixo VITE_. NUNCA colocar segredos aqui (o frontend e publico).

# O padrao same-origin funciona no CloudFront e, localmente, pelo proxy do Vite.
# Nao defina uma URL localhost em builds destinados a AWS.
VITE_IDENTITY_URL=/api/identity

# Alternativa para uma origem publica diferente:
# VITE_API_BASE_URL=https://dev.example.invalid
