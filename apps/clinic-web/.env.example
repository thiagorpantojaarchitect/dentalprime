# Exemplo de variaveis de ambiente do clinic-web (frontend Vite).
# Copie para .env.local (ignorado pelo git). Variaveis expostas ao browser
# usam o prefixo VITE_. NUNCA colocar segredos aqui (o frontend e publico).

# Por padrao o app usa o contrato same-origin /api/<dominio>. Em desenvolvimento,
# o proxy do Vite encaminha esses caminhos para os sete servicos locais. Na AWS,
# deixe estas variaveis sem definir para usar o mesmo dominio do CloudFront.
#
# Para apontar todos os dominios a outra origem publica, defina apenas:
# VITE_API_BASE_URL=https://dev.example.invalid

# Overrides opcionais por servico. Os valores abaixo documentam o contrato
# publico completo; remova/comente um override para usar o mesmo valor padrao.
VITE_IDENTITY_URL=/api/identity
VITE_PATIENT_URL=/api/patients
VITE_SCHEDULING_URL=/api/scheduling
VITE_TREATMENT_URL=/api/treatment
VITE_FINANCE_URL=/api/finance
VITE_CRM_URL=/api/crm
VITE_AI_URL=/api/ai
