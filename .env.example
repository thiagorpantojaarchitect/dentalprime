# Ambiente Docker local com dados exclusivamente sinteticos.
# Copie para .env e troque os placeholders antes de compartilhar o ambiente.
COMPOSE_PROJECT_NAME=dentalprime-development
DEPLOYMENT_ENV=development
EVENT_PROVIDER=noop
POSTGRES_DB=dentalprime
POSTGRES_USER=dentalprime
POSTGRES_PASSWORD=development-only-password
JWT_SECRET=development-only-jwt-secret-change-me-000000000000

# Bootstrap fechado do primeiro tenant/owner local (sem endpoint HTTP publico).
BOOTSTRAP_TENANT_NAME=Clinica de Desenvolvimento
BOOTSTRAP_ADMIN_EMAIL=admin@example.invalid
BOOTSTRAP_ADMIN_NAME=Administrador Local
BOOTSTRAP_ADMIN_PASSWORD=development-only-admin-password

# Portas publicadas no computador para os sete dominios.
IDENTITY_PORT=3001
PATIENT_PORT=3002
SCHEDULING_PORT=3003
TREATMENT_PORT=3004
FINANCE_PORT=3005
CRM_PORT=3006
AI_PORT=3007
POSTGRES_PORT=5432

# S3 compativel local para documentos clinicos (dados sinteticos).
MINIO_ROOT_USER=dentalprime-local
MINIO_ROOT_PASSWORD=development-only-minio-password
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# Em desenvolvimento o provedor stub e intencional e nao envia dados a terceiros.
AI_PROVIDER=stub

# Bucket sintetico criado automaticamente no MinIO local.
CLINICAL_DOCUMENTS_BUCKET=dentalprime-clinical-documents-development
