# Exemplo de variaveis de ambiente do patient-record.
# Copie para .env (ignorado pelo git) e ajuste. NUNCA commite segredos reais.
# Em producao, os valores vem do AWS Secrets Manager em runtime.

NODE_ENV=development
PORT=3002

DATABASE_URL=postgres://postgres:postgres@localhost:5432/dentalprime

# Mesmo segredo do identity-access (para validar o access token JWT).
JWT_SECRET=troque-por-um-segredo-aleatorio-de-32-ou-mais-caracteres
TRUST_PROXY=0
AWS_REGION=sa-east-1
CLINICAL_DOCUMENTS_BUCKET=dentalprime-clinical-documents-development
CLINICAL_DOCUMENTS_ENDPOINT=http://localhost:9000
CLINICAL_DOCUMENTS_FORCE_PATH_STYLE=true
CLINICAL_DOCUMENT_MAX_BYTES=26214400
PRESIGNED_URL_TTL_SECONDS=900
