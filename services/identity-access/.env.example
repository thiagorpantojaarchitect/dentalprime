# Exemplo de variaveis de ambiente do identity-access.
# Copie para .env (que e ignorado pelo git) e ajuste. NUNCA commite segredos reais.
# Em producao, estes valores sao resolvidos do AWS Secrets Manager em runtime.

NODE_ENV=development
PORT=3001

# Conexao com o Postgres local (ajuste usuario/senha/host conforme seu ambiente)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/dentalprime

# Segredo de assinatura dos JWT (>= 32 caracteres). Gere um valor aleatorio forte.
JWT_SECRET=troque-por-um-segredo-aleatorio-de-32-ou-mais-caracteres

ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=1209600
LOGIN_RATE_LIMIT_PER_MINUTE=10
INVITATION_TTL_SECONDS=259200
TRUST_PROXY=0

# Em development/test o rate limit usa memoria quando REDIS_URL estiver ausente.
# Em producao REDIS_URL e obrigatoria; o token deve vir do Secrets Manager.
# REDIS_URL=rediss://localhost:6379
# REDIS_AUTH_TOKEN=

# Bootstrap local, executado apenas pelo comando bootstrap:dev (nunca via HTTP).
# ALLOW_DEVELOPMENT_BOOTSTRAP=true
# BOOTSTRAP_TENANT_NAME=Clinica de Desenvolvimento
# BOOTSTRAP_ADMIN_EMAIL=admin@example.invalid
# BOOTSTRAP_ADMIN_NAME=Administrador
# BOOTSTRAP_ADMIN_PASSWORD=
