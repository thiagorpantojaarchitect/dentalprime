# Exemplo de variaveis de ambiente do ai-front-desk.
# Copie para .env (ignorado pelo git) e ajuste. NUNCA commite segredos reais.
# As chaves de fornecedores de IA (Bedrock/OpenAI) vem do AWS Secrets Manager.

NODE_ENV=development
PORT=3007

DATABASE_URL=postgres://postgres:postgres@localhost:5432/dentalprime

# Mesmo segredo do identity-access (para validar o access token JWT).
JWT_SECRET=troque-por-um-segredo-aleatorio-de-32-ou-mais-caracteres

# Provedor de IA: stub (dev/teste) ou bedrock (Amazon Bedrock).
AI_PROVIDER=stub

# Bedrock (usados quando AI_PROVIDER=bedrock). As credenciais vem do perfil IAM
# da task (ECS) ou do provider padrao do SDK; NUNCA coloque chaves aqui.
# BEDROCK_REGION=sa-east-1
# BEDROCK_MODEL_ID=
